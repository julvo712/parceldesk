{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "pd-ai-delivery",
    "annotations": {
      "grafana.app/folder": "parceldesk-demo"
    },
    "labels": {
      "parceldesk-owner": "demo"
    }
  },
  "spec": {
    "title": "ParcelDesk | AI investment & delivery",
    "description": "Native Grafana Cloud telemetry and direct GitHub API data for ParcelDesk.",
    "tags": [
      "parceldesk",
      "managed-by-gcx"
    ],
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "preload": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "The story",
          "description": "Measured observations only. Missing telemetry is not zero. See the measurement contract.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "## What are we spending, and how is work moving?\nCoding-model consumption from Agent Observability, alongside delivery records read directly from GitHub. Repository: **julvo712/parceldesk**. Costs cover the selected coding agents in this demo stack; delivery covers this repository."
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "noValue": "No observations",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "No observations",
                          "color": "#8e8e98",
                          "index": 0
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Recorded model-cost increase",
          "description": "Increase in the native server-side model-cost counter over the selected window. Requires at least two samples. API-equivalent consumption, excluding subscriptions; not attributed to individual PRs.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "expr": "sum by(gen_ai_agent_name)(increase(agento11y_generation_cost_usd_total{gen_ai_agent_name=~\"codex|claude-code|cursor\"}[$__range]))",
                        "legendFormat": "{{gen_ai_agent_name}}",
                        "instant": true,
                        "range": false,
                        "format": "time_series",
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "text": {
                  "valueSize": 32,
                  "titleSize": 16
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "noValue": "No observations",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "No observations",
                          "color": "#8e8e98",
                          "index": 0
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          },
          "transparent": false
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Merged pull requests",
          "description": "PRs merged within the selected time range, queried directly from GitHub.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-github-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "pd-github"
