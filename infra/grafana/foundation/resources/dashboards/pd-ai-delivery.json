          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "count"
                  ],
                  "fields": "/^number$/",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "text": {
                  "valueSize": 32,
                  "titleSize": 16
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "noValue": "No observations",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
