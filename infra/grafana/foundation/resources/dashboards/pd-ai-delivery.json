                      "spec": {
                        "queryType": "Pull_Requests",
                        "owner": "julvo712",
                        "repository": "parceldesk",
                        "options": {
                          "query": "is:merged",
                          "timeField": 2
                        }
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
