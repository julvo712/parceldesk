      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "CPU \u2022 by version",
          "description": "Sampled CPU time converted to cores by the Pyroscope data source. Compare with request rate; more traffic can require more CPU.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-pyroscope-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-profiles"
                      },
                      "spec": {
                        "queryType": "metrics",
                        "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
                        "labelSelector": "{service_name=\"$service\"}",
                        "groupBy": [
                          "service_version"
                        ],
                        "limit": 10,
                        "maxNodes": 2048
