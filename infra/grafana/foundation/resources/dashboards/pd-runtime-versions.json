{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "pd-runtime-versions",
    "annotations": {
      "grafana.app/folder": "parceldesk-demo"
    },
    "labels": {
      "parceldesk-owner": "demo"
    }
  },
  "spec": {
    "title": "ParcelDesk | Runtime by version",
    "description": "Native Grafana Cloud telemetry and direct GitHub API data for ParcelDesk.",
    "tags": [
      "parceldesk",
      "managed-by-gcx"
    ],
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "preload": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "The story",
          "description": "Measured observations only. Missing telemetry is not zero. See the measurement contract.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "## How does each version behave?\nCompare customer response times with CPU and memory profiles. Select a service and version to inspect its code. Use the same workload and container resources for a release comparison."
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "noValue": "No observations",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "No observations",
                          "color": "#8e8e98",
                          "index": 0
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Orders \u2022 requests / second",
          "description": "Measured observations only. Missing telemetry is not zero. See the measurement contract.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "expr": "sum by(service_version)(rate(http_server_duration_milliseconds_count{service_name=\"parceldesk-agent\",http_target=\"/api/orders\"}[$__rate_interval]))",
                        "legendFormat": "{{service_version}}",
                        "instant": false,
                        "range": true,
                        "format": "time_series",
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.0",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "noValue": "No observations",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "No observations",
                          "color": "#8e8e98",
                          "index": 0
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 12,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisBorderShow": false,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
