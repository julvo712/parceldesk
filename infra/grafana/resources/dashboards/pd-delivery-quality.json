          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "One session may support several tasks; allocations must sum to at most 100%. Unknown prices and unassigned sessions remain visible in FinOps. A never-accepted task stays incomplete. Exact commit/PR relationships are recorded only from an explicit link; no PR is guessed from nearby timestamps."
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
