          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "15s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "## Are the coding tools being used?\nObserved usage from this developer\u2019s real local sessions. Session volume describes activity; it does not prove productivity. Adoption percentage needs an eligible user roster and is deliberately not inferred."
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "noValue": "No observations",
                  "color": {
                    "mode": "palette-classic"
